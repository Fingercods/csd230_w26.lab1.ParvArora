classDiagram

    Product <|-- Ticket
    Product <|-- Publication
    Publication <|-- Book
    Publication <|-- Magazine
    Magazine <|-- DiscMag
    SaleableItem <|.. Product
    Serializable <|.. Product

    Cart "0..*" --> "0..*" Product : contains
    OrderEntity "0..*" --> "0..*" Product : contains

    class Product {
        -Long id
        -String productId
    }

    class Cart {
        -Long id
        -List items
        +addItem(Product)
        +getItems()
        +setItems()
    }

    class OrderEntity {
        -Long id
        -double totalAmount
        -LocalDateTime orderDate
        -Set products
        +getId()
        +getTotalAmount()
        +setTotalAmount()
        +getOrderDate()
        +setOrderDate()
        +getProducts()
        +setProducts()
        +addProduct(Product)
    }

    class Serializable {
        <<interface>>
    }

    class Ticket {
        +description
        +price
        +sellItem()
    }

    class Publication {
        <<Abstract>>
        -String title
        -double price
        -int copies
        +getPrice()
    }

    class Book {
        -String isbn
        -String author
        +sellItem()
    }

    class Magazine {
        -int orderQty
        -Date currentIssue
        +sellItem()
    }

    class DiscMag {
        -boolean hasDisc
        +sellItem()
    }

    class SaleableItem {
        <<interface>>
        +sellItem()
        +getPrice()
    }